# The mail settings. A manual run reads them as environment variables (copy
# this file to .env, or export them). The systemd service reads the same
# lines from its credential "smtp" (ImportCredential=smtp) instead, where
# every value is taken literally: no quotes, no `$`, no `export`. Fill in real
# values; never commit a filled-in version of this file.

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=you@example.com
SENDER_PASSWORD=your-app-password
RECIPIENT_EMAIL=you@example.com
